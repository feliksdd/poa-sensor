(module SWD_Pogo_1x05_P2.00mm (layer F.Cu) (tedit 00000000)
  (descr "Five exposed SMD pogo pads for SWD: VTref SWDIO SWCLK RESET GND")
  (tags "SWD pogo programming test pads")
  (attr smd)
  (fp_text reference J (at 0 -2.2) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value SWD_POGO (at 0 2.2) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "1" (at -4 1.45) (layer F.SilkS)
    (effects (font (size 0.7 0.7) (thickness 0.1)))
  )
  (fp_line (start -5 -1.1) (end 5 -1.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start 5 -1.1) (end 5 1.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start 5 1.1) (end -5 1.1) (layer F.CrtYd) (width 0.05))
  (fp_line (start -5 1.1) (end -5 -1.1) (layer F.CrtYd) (width 0.05))
  (pad 1 smd circle (at -4 0) (size 1.5 1.5) (layers F.Cu F.Mask))
  (pad 2 smd circle (at -2 0) (size 1.5 1.5) (layers F.Cu F.Mask))
  (pad 3 smd circle (at 0 0) (size 1.5 1.5) (layers F.Cu F.Mask))
  (pad 4 smd circle (at 2 0) (size 1.5 1.5) (layers F.Cu F.Mask))
  (pad 5 smd circle (at 4 0) (size 1.5 1.5) (layers F.Cu F.Mask))
)
