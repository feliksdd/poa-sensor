(module WirePads_1x02_P2.54mm (layer F.Cu) (tedit 00000000)
  (descr "Two through-hole solder pads for direct wire connection")
  (tags "wire cable solder pads")
  (attr through_hole)
  (fp_text reference J (at 0 -2.4) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value WIRE_2 (at 0 2.4) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -2.7 -1.5) (end 2.7 -1.5) (layer F.CrtYd) (width 0.05))
  (fp_line (start 2.7 -1.5) (end 2.7 1.5) (layer F.CrtYd) (width 0.05))
  (fp_line (start 2.7 1.5) (end -2.7 1.5) (layer F.CrtYd) (width 0.05))
  (fp_line (start -2.7 1.5) (end -2.7 -1.5) (layer F.CrtYd) (width 0.05))
  (pad 1 thru_hole rect (at -1.27 0) (size 2.2 2.2) (drill 1.1) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at 1.27 0) (size 2.2 2.2) (drill 1.1) (layers *.Cu *.Mask))
)
